{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "WebFetch(domain:dribbble.com)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-squash-merge.sh\"",
            "if": "Bash(gh pr merge*)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/impl-review-check.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
